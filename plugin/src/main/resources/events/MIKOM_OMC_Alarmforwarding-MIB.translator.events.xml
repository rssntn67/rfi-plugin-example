   <event>
      <uei>uei.opennms.org/translator/MIKOM_OMC_Alarmforwarding-MIB/mAlarmTrapIndeterminate</uei>
      <event-label>MIKOM_OMC_Alarmforwarding-MIB defined trap event: mAlarmTrap</event-label>
      <descr>An Indeterminate Alarm Trap Event occurred.</descr>
      <operinstruct>nodeRepeaterID=%parm[#6]%, nodeEventType=%parm[#9]%, nodeProbableCause=%parm[#10]%, nodeSpecificProblem=%parm[#11]%</operinstruct>
      <logmsg dest="logndisplay">%parm[#12]%</logmsg>
      <severity>Indeterminate</severity>
      <alarm-data reduction-key="uei.opennms.org/translator/MIKOM_OMC_Alarmforwarding-MIB/mAlarmTrap:%nodeid%:%parm[#2]%" alarm-type="1" auto-clean="true"/>
