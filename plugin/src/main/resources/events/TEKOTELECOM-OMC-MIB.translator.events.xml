<events xmlns="http://xmlns.opennms.org/xsd/eventconf">
   <event>
      <uei>uei.opennms.org/translator/TEKOTELECOM-OMC-MIB/omcActiveStateIndeterminate</uei>
      <event-label>TEKOTELECOM-OMC-MIB defined trap event: omcActiveState</event-label>
      <logmsg dest="logndisplay">%parm[#5]%</logmsg>
      <descr>This notification is sent when an Indeterminate alarm starts.</descr>
      <operinstruct>%parm[#4]%</operinstruct>	  
      <severity>Indeterminate</severity>
      <alarm-data reduction-key="uei.opennms.org/translator/TEKOTELECOM-OMC-MIB/omcActiveState:%parm[emNodeId]%:%parm[#1]%" alarm-type="1" auto-clean="true"/>
   </event>
