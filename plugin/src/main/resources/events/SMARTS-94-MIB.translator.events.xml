<events xmlns="http://xmlns.opennms.org/xsd/eventconf">

	<event>
		<uei>uei.opennms.org/translator/SMARTS-94-MIB/smTrapNotificationInformational</uei>
		<event-label>SMARTS-MIB defined trap event: translated smTrapNotification informational</event-label>
		<descr>A trap describing an Informational root cause notification.</descr>
		<operinstruct>%parm[#7]%</operinstruct>		
		<logmsg dest="logndisplay">%parm[#11]%</logmsg>
		<severity>Normal</severity>
		<alarm-data reduction-key="uei.opennms.org/translator/SMARTS-94-MIB/smTrapNotification:%nodeid%:%parm[#6]%:%parm[#5]%" alarm-type="1" auto-clean="true"/>
	</event>

