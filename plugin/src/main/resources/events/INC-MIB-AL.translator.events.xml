<events xmlns="http://xmlns.opennms.org/xsd/eventconf">
   <event>
      <uei>uei.opennms.org/translator/INC-MIB-AL/tiIncTrapCritical</uei>
      <event-label>INC-MIB-AL defined trap event: tiIncTrapCritical</event-label>
      <descr>Trap issued by the INC to an OS with a severity value of 'critical'.</descr>
      <logmsg dest="logndisplay">%parm[#8]%</logmsg>
      <operinstruct>%parm[#10]%</operinstruct>
      <severity>Critical</severity>
      <alarm-data reduction-key="uei.opennms.org/translator/INC-MIB-AL/tiIncTrap:%parm[#2]%:%parm[#12]%" alarm-type="1" auto-clean="true"/>	
   </event>
